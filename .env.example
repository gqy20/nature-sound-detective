# Required only for optional live Wan video generation.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Candidate animal stories. Template mode is offline and free; live uses an
# OpenAI-compatible text endpoint. STORY_API_KEY falls back to DASHSCOPE_API_KEY.
STORY_MODE=template
STORY_MODEL=qwen3.7-flash
STORY_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
STORY_API_KEY=

# Required for MiniMax Music 3.0 and Speech 2.8 HD.
MINIMAX_API_KEY=
MINIMAX_MUSIC_MODEL=music-3.0
MINIMAX_SPEECH_MODEL=speech-2.8-hd
MINIMAX_SPEECH_VOICE=female-tianmei
MINIMAX_MUSIC_EXCERPT_SECONDS=20

# Safe default: no paid video request. Use reuse for demos, live only for final acceptance.
WAN_VIDEO_MODE=mock
WAN_VIDEO_REUSE_PATH=
WAN_VIDEO_MODEL=wan2.7-t2v

# Optional: public previews work without a token; original-file API downloads require one.
FREESOUND_API_TOKEN=

# Community MVP. Keep DATABASE_URL server-side; Flutter only receives HTTP APIs.
DATABASE_URL=
COMMUNITY_AUTH_SECRET=

# Optional S3-compatible persistent storage (Cloudflare R2, S3, Supabase S3).
# If none are set, local development uses outputs/mvp/community_media.
COMMUNITY_S3_ENDPOINT_URL=
COMMUNITY_S3_ACCESS_KEY_ID=
COMMUNITY_S3_SECRET_ACCESS_KEY=
COMMUNITY_S3_BUCKET=
COMMUNITY_S3_PUBLIC_BASE_URL=
COMMUNITY_S3_REGION=auto
COMMUNITY_S3_PREFIX=community

# Preferred when the API is hosted on Vercel. Created automatically when a
# Vercel Blob store is linked to the project; never expose it to Flutter/web.
BLOB_READ_WRITE_TOKEN=
COMMUNITY_MEDIA_PREFIX=community
MODELSCOPE_API_TOKEN=
MODELSCOPE_STUDIO_ID=gqy2025/nature-sound-detective
